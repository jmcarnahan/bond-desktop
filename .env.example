# Copy this file to .env (git-ignored). `make app-run` and `make app-build`
# read it through MS_ENV in the Makefile and turn each non-empty line into a
# --dart-define. See QUICKSTART.md.

# MCP mode (the default): the only line you need. Ask the project owner for
# the deployed bond-mcps URL. It becomes the "Deployed" preset in
# Settings → Microsoft connection.
BOND_MCP_SERVER_URL=

# "This device" mode only: an Entra app registration you control, for calling
# Microsoft Graph directly from this machine. Leave blank for MCP mode.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
