# Copy this file to .env (git-ignored). `make app-run` and `make app-build`
# read the keys below out of it through MS_ENV in the Makefile and pass each
# non-empty one to the build as a --dart-define; BOND_BOX_KEY is read by the
# bench recipes instead. Other lines are ignored. See QUICKSTART.md.

# MCP mode (the default): the only line you need. Ask the project owner for
# the deployed bond-mcps URL. It becomes the "Deployed" preset in
# Settings → Microsoft connection.
BOND_MCP_SERVER_URL=

# The shared GPU box, if the project runs one: it prefills the box address on
# the wizard's "Where the models run" step and in Settings, Models. The access
# key is typed in the app and kept in the keychain, never compiled in.
BOND_BOX_URL=

# The same box's access key, read by the bench recipes only. A bench runs
# outside the app and has no keychain to read it from.
BOND_BOX_KEY=

# "This device" mode only: an Entra app registration you control, for calling
# Microsoft Graph directly from this machine. Leave blank for MCP mode.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
