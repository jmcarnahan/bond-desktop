tmp/
app/build/
.dart_tool/
.DS_Store
*.log

# local secrets/config — never commit
.env
.env.*
*.env
!.env.example
local.mk

# Claude Code: the hooks and shared settings are versioned (nothing secret in
# them); per-machine state, worktrees, plans and local notes stay out.
.claude/*
!.claude/settings.json
!.claude/hooks/
__pycache__/
CLAUDE.local.md

# distribution — the built pipeline's outputs and its machine-local secrets.
# dist/local/ holds the notarization key and the Sparkle signing key; the
# other three are build products measured in gigabytes.
dist/local/
dist/stage/
dist/out/
# The Windows design's outputs: fetch-llama.ps1 stages the sidecar into
# stage/, iscc writes the installer into out/. Neither is ever built here.
dist/windows/stage/
dist/windows/out/
*.dmg
*.p12
*.p8
# A Windows code-signing certificate export. None exists — the Windows design
# signs in Azure — and a stray one must not be the exception.
*.pfx
