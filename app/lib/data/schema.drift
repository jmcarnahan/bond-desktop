-- The on-disk schema, version 1 — byte-for-byte the DDL that shipped before
-- drift owned it, so an existing install adopts this file rather than
-- migrating to it.
--
-- Every table is STRICT: a value whose storage class does not match its
-- column type is rejected at write time rather than coerced, so a TEXT
-- timestamp landing in an INTEGER count fails loudly here instead of
-- surfacing as a wrong number three screens away.

CREATE TABLE messages (
  source TEXT NOT NULL DEFAULT 'email',
  source_message_id TEXT NOT NULL,
  internet_message_id TEXT,
  conversation_key TEXT NOT NULL,
  direction TEXT NOT NULL,
  subject TEXT,
  from_name TEXT,
  from_address TEXT,
  -- `AS recipientsJson` renames drift's generated getter and nothing else:
  -- the column stays `to_json` on disk. Without it the getter would be
  -- `toJson`, which collides with the `toJson()` every drift row class
  -- inherits, and the generated file would not compile.
  to_json TEXT NOT NULL DEFAULT '[]' AS recipientsJson,
  received_at TEXT,
  is_read INTEGER NOT NULL DEFAULT 0,
  body_preview TEXT,
  body_text TEXT,
  has_attachments INTEGER NOT NULL DEFAULT 0,
  source_meta_json TEXT,
  triage_status TEXT NOT NULL DEFAULT 'pending',
  triage_attempts INTEGER NOT NULL DEFAULT 0,
  triage_error TEXT,
  gate_reason TEXT,
  urgency TEXT,
  category TEXT,
  summary TEXT,
  needs_action INTEGER,
  action_items_json TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  -- Migration-added columns sit AFTER the originals: ALTER TABLE appends, so
  -- this is the only position where an upgraded install and a fresh one get
  -- identical table_info — which the parity test compares in order.
  label TEXT,
  -- `addressed_me` is 1 when this inbound message singled the user out: the
  -- sole To: recipient for mail, a 1:1 chat or an @mention for Teams. Written
  -- at ingest, from what the connector knows — it is a fact about the message,
  -- not a verdict about it.
  --
  -- `reply_expected` is triage v2's judgement of whether the sender is waiting
  -- on an answer from the owner. NULL means no v2 pass has ever judged this
  -- row, which is NOT the same as "no reply expected" — the re-judgement
  -- backfill keys off exactly that distinction, so nothing may read NULL as 0.
  --
  -- `deadline` is the date or timeframe triage read out of the message, free
  -- text as the sender wrote it ("Friday", "end of month"). NULL when the
  -- message named none.
  addressed_me INTEGER NOT NULL DEFAULT 0,
  reply_expected INTEGER,
  deadline TEXT,
  -- `needs_you_verdict` is the needs-you pass's answer to the only question
  -- the rail exists to ask: does this one want the owner? NULL means the pass
  -- has never judged this row, which is NOT the same as "no" — the unjudged
  -- rows ARE the worklist, so nothing may read NULL as 0. 0 is a judgement
  -- that the message does not need the owner; 1 is a judgement that it does.
  --
  -- Written by the `needs_you` work handler and by nobody else — the
  -- deterministic floor or, later, the model. Ingest never touches it: what a
  -- connector knows lands in `addressed_me`, which is a fact about the
  -- message, while this is a verdict about it.
  --
  -- `needs_you_reason` says why: 'teams_direct' from the floor, or the
  -- model's own evidence sentence.
  needs_you_verdict INTEGER,
  needs_you_reason TEXT,
  -- `gate_override` is the owner's hand on the gates, and it is tri-state in
  -- the same way the verdict above is. NULL means nobody has overridden
  -- anything and the pipeline's own call stands. 'user' means the owner
  -- restored this message from the dropped pile, and no gate may drop it
  -- again — not the sender gate, not the header gate, not the backlog cap.
  --
  -- The stamp is durable on purpose. `gate_reason` is a derivation and gets
  -- recomputed on every triage claim; this outranks every future one. It
  -- mirrors the `created_by`/`added_by = 'user'` stamps on storylines (see
  -- `MessageStore.stampStorylineId`): the user is telling the app what the
  -- old messages were always about, and that word outlives the passes.
  gate_override TEXT,
  PRIMARY KEY (source, source_message_id)
) STRICT;

CREATE INDEX ix_messages_conv ON messages(source, conversation_key, received_at);
CREATE INDEX ix_messages_triage ON messages(triage_status, received_at DESC);

CREATE TABLE conversations (
  source TEXT NOT NULL DEFAULT 'email',
  conversation_key TEXT NOT NULL,
  subject TEXT,
  participants_json TEXT NOT NULL DEFAULT '[]',
  state TEXT NOT NULL DEFAULT 'done',
  category TEXT,
  cta_text TEXT,
  cta_urgency TEXT NOT NULL DEFAULT 'normal',
  message_count INTEGER NOT NULL DEFAULT 0,
  inbound_count INTEGER NOT NULL DEFAULT 0,
  last_inbound_at TEXT,
  last_outbound_at TEXT,
  last_message_at TEXT,
  last_message_preview TEXT,
  state_changed_at TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  PRIMARY KEY (source, conversation_key)
) STRICT;

CREATE INDEX ix_conv_last ON conversations(last_message_at DESC);

CREATE TABLE sync_state (
  source TEXT NOT NULL DEFAULT 'email',
  folder TEXT NOT NULL,
  delta_link TEXT,
  synced_at TEXT,
  PRIMARY KEY (source, folder)
) STRICT;

CREATE TABLE work_items (
  task_kind TEXT NOT NULL,
  source TEXT NOT NULL DEFAULT 'email',
  entity_id TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'pending',
  attempts INTEGER NOT NULL DEFAULT 0,
  error TEXT,
  payload_json TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  PRIMARY KEY (task_kind, source, entity_id)
) STRICT;

CREATE INDEX ix_work_pending ON work_items(task_kind, status, created_at DESC);

CREATE TABLE message_ai (
  source TEXT NOT NULL DEFAULT 'email',
  source_message_id TEXT NOT NULL,
  extraction_json TEXT,
  extracted_at TEXT,
  PRIMARY KEY (source, source_message_id)
) STRICT;

CREATE TABLE conversation_ai (
  source TEXT NOT NULL DEFAULT 'email',
  conversation_key TEXT NOT NULL,
  embedding BLOB,
  embedded_hash TEXT,
  embed_model TEXT,
  bucket TEXT,
  bucket_reason TEXT,
  attention_score REAL,
  snoozed_until TEXT,
  updated_at TEXT NOT NULL,
  PRIMARY KEY (source, conversation_key)
) STRICT;

CREATE TABLE storylines (
  id TEXT PRIMARY KEY,
  title TEXT NOT NULL,
  summary TEXT,
  status TEXT NOT NULL DEFAULT 'suggested',
  created_by TEXT NOT NULL DEFAULT 'auto',
  title_locked INTEGER NOT NULL DEFAULT 0,
  pinned INTEGER NOT NULL DEFAULT 0,
  member_hash TEXT,
  last_activity_at TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  -- Migration-added columns sit AFTER the originals: ALTER TABLE appends, so
  -- this is the only position where an upgraded install and a fresh one get
  -- identical table_info — which the parity test compares in order.
  charter TEXT,
  charter_locked INTEGER NOT NULL DEFAULT 0,
  -- The hash of the CLUSTER this storyline was proposed out of, written once
  -- at insert and never again. `member_hash` above tracks the members as they
  -- stand right now — every membership write overwrites it — so it cannot also
  -- carry the identity of the group the user was originally asked about. A
  -- dismissal is recognised on either: this column matches the cluster the
  -- sweep rebuilds, `member_hash` matches the set as it stood when the user
  -- said no. NULL on anything a person made — no cluster proposed it.
  cluster_hash TEXT,
  -- v10 — a storyline evolves after it is named. The membership as it stood
  -- the last time the refresh pass described this storyline: the gate is an
  -- equality test against `member_hash`, so a thread added since leaves these
  -- stale and re-fires the pass. NULL means never described.
  refreshed_member_hash TEXT,
  refreshed_member_count INTEGER,
  -- v10 — what the refresh pass would write to `charter` if the charter were
  -- not the user's. A locked charter is never overwritten; the model's version
  -- is parked here for the user to accept or dismiss. NULL when there is
  -- nothing on offer.
  charter_suggestion TEXT,
  -- v10 — the recap: where things stand across every member thread, so the
  -- reader need not re-read them. `recap_open_json` and `recap_decisions_json`
  -- are JSON arrays of short strings; `recap_through` is the `received_at` of
  -- the newest message the recap has seen, which is what makes the pass skip
  -- a storyline nothing has happened in.
  recap_text TEXT,
  recap_open_json TEXT,
  recap_decisions_json TEXT,
  recap_through TEXT
) STRICT;

CREATE INDEX ix_storylines_status ON storylines(status, last_activity_at DESC);

CREATE TABLE storyline_members (
  storyline_id TEXT NOT NULL,
  source TEXT NOT NULL DEFAULT 'email',
  conversation_key TEXT NOT NULL,
  added_by TEXT NOT NULL DEFAULT 'auto',
  evidence TEXT,
  added_at TEXT NOT NULL,
  PRIMARY KEY (storyline_id, source, conversation_key)
) STRICT;

CREATE INDEX ix_storyline_members_conv
  ON storyline_members(source, conversation_key);

CREATE TABLE storyline_member_blocks (
  storyline_id TEXT NOT NULL,
  source TEXT NOT NULL DEFAULT 'email',
  conversation_key TEXT NOT NULL,
  blocked_at TEXT NOT NULL,
  -- Who wrote the block and what they (or the model) thought at the time.
  -- 'user' is the owner's own "no"; 'audit' is the re-check pass that runs
  -- after a removal (see StorylineService.audit). Only the owner's blocks
  -- teach the confirm prompt; the audit's are a consequence, not a lesson.
  blocked_by TEXT NOT NULL DEFAULT 'user',
  -- The member's evidence at removal time (the owner's removal) or the
  -- audit's own reason — so a negative example says what the model thought.
  evidence TEXT,
  PRIMARY KEY (storyline_id, source, conversation_key)
) STRICT;

-- `INTEGER PRIMARY KEY` and not `AUTOINCREMENT`: the two behave identically
-- for a table nothing is ever deleted from, and AUTOINCREMENT would add
-- sqlite's own `sqlite_sequence` table to the schema — which is not STRICT,
-- and every table here is.
CREATE TABLE feedback_events (
  id INTEGER PRIMARY KEY,
  scope TEXT NOT NULL,
  scope_key TEXT NOT NULL,
  direction TEXT NOT NULL,
  origin TEXT NOT NULL,
  created_at TEXT NOT NULL
) STRICT;

CREATE INDEX ix_feedback_scope
  ON feedback_events(scope, scope_key, created_at DESC);

-- The append-only record of what the app did on its own: what each sync
-- brought in, what the model was asked, how long it took, and what came back.
-- Both queues expose live counts and nothing that outlives a process; this
-- table is the only history.
--
-- `INTEGER PRIMARY KEY` for feedback_events' reason (AUTOINCREMENT drags in
-- sqlite_sequence, which is not STRICT). Rows here ARE deleted — see
-- MessageStore.pruneActivity — but only from the old end, so the max rowid
-- survives every prune and no id is ever reused in practice.
--
-- `count` is a column and not a field inside detail_json so the stats header
-- can SUM it in SQL without depending on the JSON1 extension.
CREATE TABLE activity_events (
  id INTEGER PRIMARY KEY,
  kind TEXT NOT NULL,
  source TEXT,
  status TEXT NOT NULL,
  entity_id TEXT,
  count INTEGER,
  duration_ms INTEGER,
  detail_json TEXT,
  created_at TEXT NOT NULL
) STRICT;

CREATE INDEX ix_activity_created
  ON activity_events(created_at DESC);
CREATE INDEX ix_activity_kind
  ON activity_events(kind, created_at DESC);

CREATE TABLE sender_prefs (
  address TEXT PRIMARY KEY,
  disposition TEXT NOT NULL,
  updated_at TEXT NOT NULL
) STRICT;

-- `key` is quoted because it is a keyword to drift's SQL parser, which
-- otherwise drops the column from the schema it generates. The column name
-- itself is unchanged, so the pre-drift installs this file adopts match.
CREATE TABLE app_prefs (
  "key" TEXT PRIMARY KEY,
  value TEXT NOT NULL
) STRICT;

-- One suggested reply, and the MESSAGE it answers.
--
-- The key is the message rather than the thread, because that is what a
-- suggestion actually is: an answer to one thing somebody said. A thread that
-- gets a second question earns a second suggestion instead of having the
-- first overwritten, and the answer to a message stays readable beside the
-- message it belongs to however long the thread runs on.
--
-- `conversation_key` rides along as a column so a thread can find its newest
-- suggestion in one indexed read — `ix_drafts_conv` below — without walking
-- the messages table to learn which thread each draft came from.
--
-- Staleness needs no sweep under this key. A reply written against the
-- second-to-last thing that was said is simply not the row the thread's
-- newest inbound message points at, so the read scopes itself and no sync
-- has to delete anything to keep a wrong answer off the screen.
--
-- `graph_draft_id` / `web_link` are null until the draft has been pushed to
-- Outlook, which only happens on the user's own click.
CREATE TABLE drafts (
  source TEXT NOT NULL DEFAULT 'email',
  conversation_key TEXT NOT NULL,
  reply_to_message_id TEXT NOT NULL,
  body TEXT NOT NULL,
  evidence TEXT,
  status TEXT NOT NULL DEFAULT 'suggested',
  graph_draft_id TEXT,
  web_link TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  -- Migration-added columns sit AFTER the originals: ALTER TABLE appends, so
  -- this is the only position where an upgraded install and a fresh one get
  -- identical table_info.
  --
  -- `options_json` is a JSON array of at most two ready-to-send short replies,
  -- `[{"stance": "…", "body": "…"}]`, written by the same model call that
  -- writes `body` — the long form. A column rather than a table because
  -- nothing ever queries INTO the options, and a second table keyed by the
  -- same message would be a second row saying what this one already says.
  --
  -- `options_dismissed` keeps the row when the user closes the suggestions,
  -- the same trick `status = 'dismissed'` plays for the long form: deleting it
  -- would let the auto-enqueue write the identical options straight back.
  options_json TEXT,
  options_dismissed INTEGER NOT NULL DEFAULT 0,
  -- `context_json` is the inventory of what this draft READ:
  -- `{"documents": […], "directories": […], "files": [{dir, path, locator}],
  -- "skills": […]}`. Stored rather than recomputed because the composer's
  -- provenance line has to name the file a fact came from, and by the time it
  -- renders the retrieval that found it is long over — `payload_json` cannot
  -- carry it (a requeue nulls it) and a second table would say what this row
  -- already says.
  context_json TEXT,
  PRIMARY KEY (source, reply_to_message_id)
) STRICT;

CREATE INDEX ix_drafts_conv ON drafts(source, conversation_key);

-- Per-message notification state: admitted 'pending', settled exactly once to
-- 'notified' or 'suppressed'. `reason` is diagnostic only (settled|deadline|
-- gated|read|done|not_worthy|stale). 'eligible' is deliberately NOT a stored
-- state — worthiness is evaluated at settle time, against the freshest verdict.
CREATE TABLE message_notify (
  source TEXT NOT NULL,
  source_message_id TEXT NOT NULL,
  conversation_key TEXT NOT NULL,
  state TEXT NOT NULL DEFAULT 'pending',
  reason TEXT,
  deadline_at TEXT NOT NULL,
  settled_at TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  PRIMARY KEY (source, source_message_id)
) STRICT;

CREATE INDEX ix_message_notify_open ON message_notify(state, deadline_at);
CREATE INDEX ix_messages_created ON messages(created_at DESC);

-- One row per message, tracking it through the pipeline: which stage it is
-- at, what the app decided, and whether the user needed to know.
--
-- Everything the home feed shows is here, denormalized on purpose. The screen
-- is left open all day over a growing mailbox, so a page has to be one indexed
-- scan rather than a five-table join re-evaluated per row — and the snapshot
-- columns (`needs_you`, `urgency`, `storyline_id`) are frozen at the moment
-- the app decided, so history reads next week the way it read the day it
-- happened.
--
-- `received_at` is NOT NULL and stored as COALESCE(received_at, created_at):
-- it is half the paging cursor, and a NULL in a row-value comparison is
-- neither less nor greater than anything.
--
-- Stage vocabulary is pending|running|done|skipped|error, and `skipped` is a
-- real END state rather than a missing one — a gated message's bar must stop,
-- not wait forever for an extraction nothing will ever queue.
--
-- `dropped` duplicates what `outcome` already says, deliberately. The default
-- feed hides dropped rows and sqlite cannot range-scan `outcome <> 'dropped'`,
-- so the discriminator leads the visible index and turns the common read into
-- an equality seek.
CREATE TABLE message_progress (
  source TEXT NOT NULL,
  source_message_id TEXT NOT NULL,
  conversation_key TEXT NOT NULL,
  received_at TEXT NOT NULL,
  ingest_state TEXT NOT NULL DEFAULT 'done',
  triage_state TEXT NOT NULL DEFAULT 'pending',
  extract_state TEXT NOT NULL DEFAULT 'pending',
  storyline_state TEXT NOT NULL DEFAULT 'pending',
  settle_state TEXT NOT NULL DEFAULT 'pending',
  triage_at TEXT,
  extract_at TEXT,
  storyline_at TEXT,
  settle_at TEXT,
  outcome TEXT NOT NULL DEFAULT 'pending',
  dropped INTEGER NOT NULL DEFAULT 0,
  drop_reason TEXT,
  storyline_id TEXT,
  needs_you INTEGER NOT NULL DEFAULT 0,
  urgency TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  -- Migration-added columns sit AFTER the originals, for the reason the
  -- drafts table states: ALTER TABLE appends, so this is the only position
  -- where an upgraded install and a fresh one get identical table_info.
  --
  -- Drafting is a stage like any other and reads in the same vocabulary —
  -- pending|running|done|skipped|error. `skipped` covers both messages
  -- nothing will ever draft for and the ones the model read and decided need
  -- no answer: either way the stage has finished, and a bar that waited for a
  -- reply nobody is going to write would wait forever.
  draft_state TEXT NOT NULL DEFAULT 'pending',
  draft_at TEXT,
  PRIMARY KEY (source, source_message_id)
) STRICT;

CREATE INDEX ix_message_progress_feed
  ON message_progress(received_at DESC, source_message_id DESC);
CREATE INDEX ix_message_progress_visible
  ON message_progress(dropped, received_at DESC, source_message_id DESC);
CREATE INDEX ix_message_progress_conv
  ON message_progress(source, conversation_key);

-- One vector per message, and the SOURCE OF TRUTH for it: the sqlite-vec
-- index built over these rows is derived, disposable, and rebuildable from
-- this table without a single model call.
--
-- `id` is a surrogate because it is also the vec0 index's rowid, and a
-- message's own rowid is not stable across a VACUUM. Bare `INTEGER PRIMARY
-- KEY` and not AUTOINCREMENT, for the reason `feedback_events` gives.
--
-- `indexed_at` NULL is the backfill worklist: a row whose vector exists but
-- has not reached the index yet, which is the normal state after a rebuild or
-- after the extension turned out to be unavailable at write time.
CREATE TABLE message_vectors (
  id INTEGER PRIMARY KEY,
  source TEXT NOT NULL,
  source_message_id TEXT NOT NULL,
  embedding BLOB NOT NULL,
  dims INTEGER NOT NULL,
  embedded_hash TEXT NOT NULL,
  embed_model TEXT NOT NULL,
  received_at TEXT,
  embedded_at TEXT NOT NULL,
  indexed_at TEXT
) STRICT;

CREATE UNIQUE INDEX ix_message_vectors_message
  ON message_vectors(source, source_message_id);
CREATE INDEX ix_message_vectors_unindexed ON message_vectors(indexed_at);

-- Everything that came with a message: one row per attachment, per source.
--
-- The three attachment tables split by lifetime and size. This one holds the
-- metadata a row draws and the pipeline judges on — small, written on every
-- sighting, and safe to re-upsert. `attachment_text` holds the extracted
-- words (up to 200 K chars), read only by the chunker. `attachment_chunks`
-- holds the embedded passages and is the source of truth for the vec0 index
-- built over it.
--
-- The primary key is the connector's own identity for the file. Mail uses the
-- Graph attachment id; Teams uses the entry id, or the hosted-content id for
-- an image pasted into the body. `ordinal` records the order the connector
-- listed them in, which is both how a row draws its chips and the tie-break
-- the text policy caps on.
--
-- `size` is 0 rather than NULL when unknown, because the Teams wire never
-- states it and a later resolve should be able to raise it with MAX() without
-- a NULL check at every call site.
--
-- The `text_*`, `digest_*`, `blob_*`, `thumb_path` and `pinned_storyline_id`
-- columns belong to later stages and to the owner: a re-sync updates the
-- metadata and never touches them.
CREATE TABLE attachments (
  source TEXT NOT NULL DEFAULT 'email',
  source_message_id TEXT NOT NULL,
  attachment_id TEXT NOT NULL,
  ordinal INTEGER NOT NULL DEFAULT 0,
  kind TEXT NOT NULL DEFAULT 'file',
  name TEXT,
  content_type TEXT,
  size INTEGER NOT NULL DEFAULT 0,
  is_inline INTEGER NOT NULL DEFAULT 0,
  content_id TEXT,
  source_url TEXT,
  thumbnail_url TEXT,
  card_text TEXT,
  item_subject TEXT,
  item_from TEXT,
  item_received TEXT,
  text_status TEXT NOT NULL DEFAULT 'pending',
  text_reason TEXT,
  text_truncated INTEGER NOT NULL DEFAULT 0,
  text_chars INTEGER NOT NULL DEFAULT 0,
  digest_status TEXT NOT NULL DEFAULT 'pending',
  digest_json TEXT,
  blob_path TEXT,
  blob_sha256 TEXT,
  blob_fetched_at TEXT,
  thumb_path TEXT,
  pinned_storyline_id TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  PRIMARY KEY (source, source_message_id, attachment_id)
) STRICT;

CREATE INDEX ix_attachments_message
  ON attachments(source, source_message_id, ordinal);
CREATE INDEX ix_attachments_pinned ON attachments(pinned_storyline_id);

-- The extracted words, kept apart from the metadata because they are two
-- orders of magnitude larger and nothing but the chunker reads them.
CREATE TABLE attachment_text (
  source TEXT NOT NULL DEFAULT 'email',
  source_message_id TEXT NOT NULL,
  attachment_id TEXT NOT NULL,
  -- `extracted_text` rather than the obvious `text`, and not fixable with an
  -- `AS` alias the way `to_json` is: the migration-snapshot generator names
  -- its columns from the SQL name and ignores the alias, so a column called
  -- `text` produces a `text` getter that collides with the
  -- `ColumnBuilder<String> text()` every drift table inherits, in a file
  -- nothing in this repo edits by hand.
  extracted_text TEXT NOT NULL,
  chars INTEGER NOT NULL DEFAULT 0,
  fetched_at TEXT NOT NULL,
  PRIMARY KEY (source, source_message_id, attachment_id)
) STRICT;

-- One passage of a document, and the SOURCE OF TRUTH for its vector, for the
-- reason `message_vectors` gives: the sqlite-vec index over these rows is
-- derived and rebuildable without a single model call.
--
-- `id` is a surrogate because it is also the vec0 rowid, and a row's own
-- rowid is not stable across a VACUUM. `locator` is what the passage is
-- called out loud — 'Sheet Q3 rows 41-80', 'slide 4', 'part 2', 'digest'.
--
-- `indexed_at` NULL is the backfill worklist. Unlike `message_vectors`, a
-- chunk row is written before it is embedded, so `embedding` is nullable and
-- the backfill also skips rows that have no vector yet.
CREATE TABLE attachment_chunks (
  id INTEGER PRIMARY KEY,
  source TEXT NOT NULL,
  source_message_id TEXT NOT NULL,
  attachment_id TEXT NOT NULL,
  seq INTEGER NOT NULL,
  locator TEXT NOT NULL DEFAULT '',
  -- Renamed for `attachment_text.extracted_text`'s reason.
  chunk_text TEXT NOT NULL,
  chars INTEGER NOT NULL DEFAULT 0,
  embedding BLOB,
  dims INTEGER NOT NULL DEFAULT 0,
  embed_model TEXT,
  embedded_at TEXT,
  indexed_at TEXT,
  created_at TEXT NOT NULL
) STRICT;

CREATE UNIQUE INDEX ix_attachment_chunks_seq
  ON attachment_chunks(source, source_message_id, attachment_id, seq);
CREATE INDEX ix_attachment_chunks_unindexed ON attachment_chunks(indexed_at);

-- One local directory the owner registered — typically a Claude Code project.
-- The app re-reads it on every sync, so this row is the registration and the
-- ledger of the last read, not a copy of anything: `path` is where it lives,
-- `bookmark` is the security-scoped bookmark that keeps it readable after a
-- relaunch (NULL on an unsandboxed build, where the path alone works), and
-- `walked_at`/`root_hash`/`files_count`/`text_bytes` are what the last walk
-- found.
--
-- `id` is the first 16 hex of sha256(path) rather than a surrogate, so
-- registering the same folder twice is the same row without a lookup.
--
-- `digests` and `honor_gitignore` are the two per-directory switches. Digests
-- are ON because the measuring use case is "ask me about my analysis";
-- `.gitignore` is NOT honoured because Claude Code analyses land in ignored
-- `output/` and `reports/` folders — a hard denylist and `.bondignore` apply
-- either way.
CREATE TABLE context_dirs (
  id TEXT NOT NULL PRIMARY KEY,
  path TEXT NOT NULL,
  display_name TEXT NOT NULL,
  bookmark BLOB,
  -- pending|reading|ready|error|unavailable
  status TEXT NOT NULL DEFAULT 'pending',
  error TEXT,
  walked_at TEXT,
  root_hash TEXT,
  files_count INTEGER NOT NULL DEFAULT 0,
  text_bytes INTEGER NOT NULL DEFAULT 0,
  brief_json TEXT,
  brief_hash TEXT,
  digests INTEGER NOT NULL DEFAULT 1,
  honor_gitignore INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
) STRICT;

-- What ties a directory to a room, and the ONLY such table: register once,
-- link many. Unlinking is a row delete and costs no re-index, which is the
-- whole reason the index tables hang off `dir_id` and not off a thread.
--
-- `scope_kind` is an open set — 'thread' and 'storyline' today, 'sender' and
-- 'all' are future values rather than future migrations. `source` is the
-- connector for a thread and '' for a storyline, whose ids are already global.
CREATE TABLE context_links (
  dir_id TEXT NOT NULL,
  scope_kind TEXT NOT NULL,
  source TEXT NOT NULL DEFAULT '',
  scope_key TEXT NOT NULL,
  added_at TEXT NOT NULL,
  PRIMARY KEY (dir_id, scope_kind, source, scope_key)
) STRICT;

CREATE INDEX ix_context_links_scope
  ON context_links(scope_kind, source, scope_key);

-- One file inside a registered directory, as the last walk saw it.
--
-- `size`/`mtime` are the cheap diff and `sha256` the honest one: a file whose
-- stat is unchanged is not re-read, and a file whose hash matches a row the
-- walk no longer sees is a move rather than a delete-and-add — which is what
-- keeps its passages and their vectors instead of paying for them again.
--
-- `claude_chain` is the JSON list of CLAUDE.md rel paths above this file, root
-- first: Claude Code's own on-demand rule, stored per row so a retrieved
-- passage can carry the notes that govern its subtree without briefing every
-- nested CLAUDE.md. `description`/`paths_json` are the parsed skill/rule
-- frontmatter, `digest_json` the model's summary of the file, and
-- `desc_embedding` the skill description's vector — the three the reconcile
-- pass must NEVER clobber when it only re-reads bytes.
CREATE TABLE context_files (
  id INTEGER PRIMARY KEY,
  dir_id TEXT NOT NULL,
  rel_path TEXT NOT NULL,
  size INTEGER NOT NULL DEFAULT 0,
  mtime TEXT NOT NULL DEFAULT '',
  sha256 TEXT NOT NULL DEFAULT '',
  -- claude_md|skill|rule|doc|code|data|other
  kind TEXT NOT NULL DEFAULT 'other',
  claude_chain TEXT NOT NULL DEFAULT '[]',
  description TEXT,
  paths_json TEXT,
  digest_json TEXT,
  digest_status TEXT NOT NULL DEFAULT 'pending',
  desc_embedding BLOB,
  text_chars INTEGER NOT NULL DEFAULT 0,
  status TEXT NOT NULL DEFAULT 'ok',
  seen_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
) STRICT;

CREATE UNIQUE INDEX ix_context_files_path
  ON context_files(dir_id, rel_path);

-- The extracted words, kept apart from the metadata for `attachment_text`'s
-- reason: two orders of magnitude larger, and nothing but the chunker and the
-- section reader touch them.
CREATE TABLE context_text (
  file_id INTEGER NOT NULL PRIMARY KEY,
  extracted_text TEXT NOT NULL,
  chars INTEGER NOT NULL DEFAULT 0
) STRICT;

-- One passage of one file, and the SOURCE OF TRUTH for its vector — the
-- sqlite-vec index over these rows is derived and rebuildable without a model
-- call, exactly as `attachment_chunks` is.
--
-- `locator` is what the passage is called out loud: a heading breadcrumb
-- ('Pricing > Q4 rates'), 'lines 61-120', 'part 2', or 'digest'. `indexed_at`
-- NULL is the backfill worklist, and `embedding` is nullable because a chunk
-- row is written the moment the file is split and its vector arrives one POST
-- later.
CREATE TABLE context_chunks (
  id INTEGER PRIMARY KEY,
  file_id INTEGER NOT NULL,
  seq INTEGER NOT NULL,
  locator TEXT NOT NULL DEFAULT '',
  chunk_text TEXT NOT NULL,
  chars INTEGER NOT NULL DEFAULT 0,
  embedding BLOB,
  dims INTEGER NOT NULL DEFAULT 0,
  embed_model TEXT,
  embedded_at TEXT,
  indexed_at TEXT,
  created_at TEXT NOT NULL
) STRICT;

CREATE UNIQUE INDEX ix_context_chunks_seq ON context_chunks(file_id, seq);
CREATE INDEX ix_context_chunks_unindexed ON context_chunks(indexed_at);
CREATE INDEX ix_context_chunks_file ON context_chunks(file_id);

-- First-run setup and machine-local state — which step the wizard reached,
-- the download ledger, whether the sandbox container was migrated. Not
-- mailbox data: it survives `wipeAll` (the store never deletes from it) and
-- never leaves this machine.
--
-- `"key"` is quoted for `app_prefs`'s reason, above: drift drops an unquoted
-- column of that name from the schema it generates.
CREATE TABLE setup_state (
  "key" TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL,
  updated_at TEXT NOT NULL
) STRICT;
