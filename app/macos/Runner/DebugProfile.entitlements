<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The debug counterpart of Release.entitlements, and unsandboxed for the same
  reasons: the app spawns a llama-server child, reads a user-chosen models
  folder from that child, and keeps tens of gigabytes outside any container.
  See Release.entitlements for the full reasoning.

  One key more than Release: cs.allow-jit, which the Dart VM needs in a debug
  build. The hardened runtime never applies to a build made here at all — it
  is a codesign flag dist/sign.sh adds in its Developer ID branch — and
  distribution signing lives in dist/sign.sh.

  Keep the shared keys in sync with Release.entitlements: a difference between
  the two is behaviour that only appears in one of them.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
