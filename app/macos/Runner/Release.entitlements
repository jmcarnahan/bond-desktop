<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  keychain-access-groups is still ABSENT, and Manual signing does not change
  that. Measured against this Xcode: the key present as
  $(AppIdentifierPrefix)com.bondinbox.app fails the ad-hoc build with
  "Runner requires a provisioning profile", and the key present as an empty
  array fails identically — it is the key itself, not the group string, that
  makes Xcode demand a profile. Removing the key builds clean.

  This file therefore stays key-less on purpose, so ad-hoc builds keep
  working. The keyed variant already exists as ReleaseSigned.entitlements
  (DebugProfile.entitlements has DebugProfileSigned.entitlements); a build
  selects it by setting BOND_ENTITLEMENTS_SUFFIX = Signed in
  Runner/Configs/SigningLocal.xcconfig alongside a real Apple Development
  identity. Nothing to add here — keep the non-keychain keys in sync with the
  Signed variant.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
