# Template for dist/local/dist.env — the machine-local settings `make dist`
# reads. Copy it, fill it in, and keep the real file (and everything else in
# dist/local/) out of git and in a password manager. See dist/README.md.
#
#   cp dist/local.env.example dist/local/dist.env
#
# Nothing in THIS file is secret; the files it points at are.

# The Developer ID Application identity, from:
#   security find-identity -v -p codesigning
# Prefer the 40-hex SHA-1 that line starts with over the name it ends with. A
# RENEWED certificate carries the same name as the one it replaces, so once the
# old one is back in the keychain the name matches two identities and codesign
# refuses the whole run as ambiguous. The hash always names exactly one.
DIST_SIGN_IDENTITY=

# The 10-character team id — the part in parentheses in the identity above.
DIST_TEAM_ID=

# Path to the App Store Connect API key notarytool authenticates with. Download
# it once from App Store Connect → Users and Access → Integrations → Keys; it
# cannot be downloaded twice. Keep it mode 600, anywhere OUTSIDE the repo —
# ~/.bond-signing/AuthKey_<id>.p8 is where this project's author keeps it, so
# that removing a worktree after a merge cannot delete the only local copy.
DIST_NOTARY_KEY_PATH=

# The Key ID shown next to that key on the same page.
DIST_NOTARY_KEY_ID=

# The Issuer ID from the top of that page. Team keys only — leave blank for an
# individual key, where passing --issuer makes notarytool reject the request.
DIST_NOTARY_ISSUER=

# Path to the Sparkle EdDSA private key, exported with `generate_keys -x`.
# This one is a real secret: whoever holds it can sign an update the app will
# install without asking, and Sparkle cannot re-issue it — every installed copy
# trusts this key and no other. Keep it mode 600 and OUTSIDE the repo;
# ~/.bond-signing/sparkle_ed25519.key is where this project's author keeps it,
# beside the .p8, so that removing a worktree cannot delete the only local copy.
DIST_SPARKLE_PRIVATE_KEY_PATH=

# The matching public key, which `generate_keys` prints (and `generate_keys -p`
# prints again later) — 44 base64 characters. It goes into Info.plist as
# SUPublicEDKey, so it is public by definition. `make dist-check` derives the
# public half of the key file above and refuses a pair that does not match.
DIST_SPARKLE_PUBLIC_KEY=

# Where the appcast XML is served from. Becomes SUFeedURL in Info.plist, so it
# has to be https and it has to keep working for the life of every build that
# carries it. GitHub Pages from `main` /docs, for this project:
#   https://jmcarnahan.github.io/bond-desktop/appcast/appcast.xml
DIST_APPCAST_URL=

# The prefix generate_appcast prepends to the DMG's file name. Must end in `/`.
# A literal {version} is substituted with the release's version, which is what
# lets one line here name a per-tag GitHub Releases URL:
#   https://github.com/jmcarnahan/bond-desktop/releases/download/v{version}/
DIST_DOWNLOAD_URL_PREFIX=
