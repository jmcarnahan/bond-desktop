# tools/model-box.env.example — the environment tools/model-box.sh deploys into.
# Copy to ./model-box.env (git-ignored by *.env) and fill in. This file is
# tracked and the repo is public: placeholders only, never real values.
#
# Every value comes from the platform that already runs in the account: the
# region, subnet and listener from its tfvars, the hostname its services are
# path-mounted under, the image and tags its SCPs insist on. The preflight
# (`tools/model-box.sh preflight`) checks each of them read-only.

# The AWS CLI profile signed in to the account, and the account it must be.
BOX_PROFILE=<profile>
BOX_ACCOUNT=<account-id>
BOX_REGION=<region>

# Private subnets of the platform VPC with a NAT (or transit) default route,
# comma-separated, in different zones: `up` tries them in order when a zone
# has no capacity for the type. Each needs a default route out, because
# the box pulls a container image and ~30 GB of weights at boot.
BOX_SUBNET=<subnet-a>,<subnet-b>

# The platform ALB's HTTPS listener, the one its services add path rules to,
# and the hostname that reaches that ALB. The box answers at
# https://$BOX_HOST$BOX_PATH/prose and …/bulk.
BOX_LISTENER_ARN=<listener-arn>
BOX_HOST=<platform-host>
BOX_PATH=/models
# Any priority the listener does not already use. Lower wins; the platform's
# catch-all is the listener's default action, so any number works for a path
# nobody else routes.
BOX_RULE_PRIORITY=95

# The image. A Deep Learning AMI is the natural choice, but an account whose
# SCPs admit only its own golden images needs one of those: a GPU image with
# the NVIDIA driver. The newest image matching BOX_AMI_NAME from BOX_AMI_OWNER
# is used, or BOX_AMI pins one.
BOX_AMI_OWNER=<golden-image-account-id>
BOX_AMI_NAME=<golden-gpu-image-name-pattern-*>
# BOX_AMI=<ami-id>

# The tags the account's SCPs require on an instance, its volume and its
# network interface, as key=value,key=value. The preflight's dry run says
# which resource is refused when one is missing.
BOX_TAGS=<key>=<value>,<key>=<value>

# The box. g6e.xlarge is one L40S (48 GB), which holds the 27B and the 4B.
BOX_TYPE=g6e.xlarge
BOX_DISK=200
BOX_DAYS=14
